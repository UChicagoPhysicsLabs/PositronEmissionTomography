  create_bd_intf_pin -mode Slave -vlnv xilinx.com:interface:aximm_rtl:1.0 S_AXI3


  # Create pins
  create_bd_pin -dir I -type clk clk
  create_bd_pin -dir I -from 13 -to 0 sig_in1
  create_bd_pin -dir I sign
  create_bd_pin -dir O -from 13 -to 0 over_sig
  create_bd_pin -dir O -from 0 -to 0 Res
  create_bd_pin -dir I -from 13 -to 0 sig_in
  create_bd_pin -dir O -from 13 -to 0 over_sig1
  create_bd_pin -dir I -type rst s_axi_aresetn
  create_bd_pin -dir O -from 13 -to 0 gpio_io_o1

  # Create instance: overthreshold_b, and set properties
  set block_name overthreshold_detector
  set block_cell_name overthreshold_b
  if { [catch {set overthreshold_b [create_bd_cell -type module -reference $block_name $block_cell_name] } errmsg] } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2095 -severity "ERROR" "Unable to add referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   } elseif { $overthreshold_b eq "" } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2096 -severity "ERROR" "Unable to referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   }
  
  # Create instance: util_vector_logic_0, and set properties
  set util_vector_logic_0 [ create_bd_cell -type ip -vlnv xilinx.com:ip:util_vector_logic:2.0 util_vector_logic_0 ]
  set_property -dict [list \
    CONFIG.C_OPERATION {or} \
    CONFIG.C_SIZE {1} \
  ] $util_vector_logic_0


  # Create instance: overthreshold_a, and set properties
  set block_name overthreshold_detector
  set block_cell_name overthreshold_a
  if { [catch {set overthreshold_a [create_bd_cell -type module -reference $block_name $block_cell_name] } errmsg] } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2095 -severity "ERROR" "Unable to add referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   } elseif { $overthreshold_a eq "" } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2096 -severity "ERROR" "Unable to referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   }
  
  # Create instance: overthreshold_from_ps, and set properties
  set overthreshold_from_ps [ create_bd_cell -type ip -vlnv xilinx.com:ip:axi_gpio:2.0 overthreshold_from_ps ]
  set_property -dict [list \
    CONFIG.C_ALL_OUTPUTS {1} \
    CONFIG.C_DOUT_DEFAULT {0x00001E00} \
    CONFIG.C_GPIO_WIDTH {14} \
  ] $overthreshold_from_ps


  # Create interface connections
  connect_bd_intf_net -intf_net Conn1 [get_bd_intf_pins overthreshold_from_ps/S_AXI] [get_bd_intf_pins S_AXI3]

  # Create port connections
  connect_bd_net -net adc_dat_a_i_1 [get_bd_pins sig_in] [get_bd_pins overthreshold_a/sig_in]
  connect_bd_net -net adc_dat_b_i_1 [get_bd_pins sig_in1] [get_bd_pins overthreshold_b/sig_in]
  connect_bd_net -net overthreshold_a_over [get_bd_pins overthreshold_a/over] [get_bd_pins util_vector_logic_0/Op2]
  connect_bd_net -net overthreshold_a_over_sig [get_bd_pins overthreshold_a/over_sig] [get_bd_pins over_sig1]
  connect_bd_net -net overthreshold_b_over [get_bd_pins overthreshold_b/over] [get_bd_pins util_vector_logic_0/Op1]
  connect_bd_net -net overthreshold_b_over_sig [get_bd_pins overthreshold_b/over_sig] [get_bd_pins over_sig]
  connect_bd_net -net s_axi_aresetn_1 [get_bd_pins s_axi_aresetn] [get_bd_pins overthreshold_from_ps/s_axi_aresetn]
  connect_bd_net -net sign_1 [get_bd_pins sign] [get_bd_pins overthreshold_a/sign] [get_bd_pins overthreshold_b/sign]
  connect_bd_net -net threshold_in_1 [get_bd_pins overthreshold_from_ps/gpio_io_o] [get_bd_pins overthreshold_a/threshold_in] [get_bd_pins overthreshold_b/threshold_in] [get_bd_pins gpio_io_o1]
  connect_bd_net -net util_ds_buf_0_IBUF_OUT [get_bd_pins clk] [get_bd_pins overthreshold_a/clk] [get_bd_pins overthreshold_b/clk] [get_bd_pins overthreshold_from_ps/s_axi_aclk]
  connect_bd_net -net util_vector_logic_0_Res [get_bd_pins util_vector_logic_0/Res] [get_bd_pins Res]

  # Restore current instance
  current_bd_instance $oldCurInst
}
  
